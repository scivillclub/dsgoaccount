# ── firebase2 (scivill-2c3c4) — scivill, deepthink, nodetask 담당 ─────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── firebase1 (scivill-account-3c5c5) — 전체 서비스 공유 계정 DB ──────────────
NEXT_PUBLIC_ACCOUNTS_FIREBASE_API_KEY=
NEXT_PUBLIC_ACCOUNTS_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_ACCOUNTS_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_ACCOUNTS_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_ACCOUNTS_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_ACCOUNTS_FIREBASE_APP_ID=

# ── Firebase Admin SDK (서버사이드 전용) ──────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── JWT 세션 시크릿 ───────────────────────────────────────────────────────────
SESSION_SECRET=your_session_secret_here
SECURITY_PIN=your_security_pin_here

# ── SSO 허용 redirect_uri (comma-separated, /api/auth/sso 경로만 허용) ────────
SSO_ALLOWED_ORIGINS=https://dsgo.vercel.app,https://scivill.vercel.app,https://scivill-oryaform.vercel.app,https://scivill-sheet.vercel.app,https://scivill-qrlink.vercel.app,https://scivill-deepthink.vercel.app,https://scivill-nodetask.vercel.app,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# ── dsgoaccount 공개 URL / 외부 OAuth 앱 (서버 전용) ─────────────────────────
BASE_URL=https://dsgoaccount.vercel.app
BYTENODE_CLIENT_ID=
BYTENODE_CLIENT_SECRET=
ORYA_SERVICE_KEY=
ORYA_SERVICE_SECRET=
ORYA_CALLBACK_URL=https://dsgoaccount.vercel.app/api/auth/orya/callback

# ── 이메일 발송 (이메일 인증 코드용) ─────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── imgBB — SW/HW/DS R&D 게시글 이미지 업로드 ────────────────────────────────
IMGBB_API_KEY=your_imgbb_api_key

# ── 서비스 URL ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEEPLINK_URL=https://scivill-deepthink.vercel.app
NEXT_PUBLIC_NODETASK_URL=https://scivill-nodetask.vercel.app
NEXT_PUBLIC_ONSHEET_URL=https://scivill-sheet.vercel.app
NEXT_PUBLIC_ORYAFORM_URL=https://scivill-oryaform.vercel.app
NEXT_PUBLIC_QRLINK_URL=https://scivill-qrlink.vercel.app

# ── AI API Keys (서버사이드 전용) ─────────────────────────────────────────────
JINA_API_KEY=
GROQ_KEYS=key1,key2,key3
GROQ_MODEL=llama-3.1-8b-instant
CEREBRAS_KEYS=key1,key2,key3
CEREBRAS_MODEL=llama3.1-8b
GENERIC_KEYS=key1,key2,key3
GENERIC_BASE_URL=https://models.inference.ai.azure.com
GENERIC_MODEL=gpt-4o-mini
OPENROUTER_KEYS=key1,key2,key3
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
